# Copy to `.env` and adjust. `.env` is git-ignored.
# Local PostgreSQL connection strings (these are also the built-in defaults).
# With a password:      postgres://user:password@localhost:5432/cs_trainer
# Linux peer auth over the local socket (no password):
#                       postgres:///cs_trainer?host=/var/run/postgresql
DATABASE_URL=postgres://localhost:5432/cs_trainer
# Used only when NODE_ENV=test. Test setup refuses to run unless the database
# name ends in "_test".
TEST_DATABASE_URL=postgres://localhost:5432/cs_trainer_test

# At least 32 random characters. Required in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

PORT=9090
# Set to the number of reverse proxies in front of the app in production (e.g. 1).
TRUST_PROXY=0
# Defaults to true when NODE_ENV=production. Only set to false for local HTTP testing.
# COOKIE_SECURE=false

# Demo Review (optional). Uploaded .dem files are stored on disk here.
# DEMO_STORAGE_DIR=./storage/demos
# DEMO_MAX_MB=600
# DEMO_PARSE_TIMEOUT_S=300
# DEMO_LIMIT_PER_TEAM=50
# Set to "off" to stop this process from parsing demos (e.g. a separate worker).
# DEMO_WORKER=on

# Steam sign-in (OpenID). APP_ORIGIN is the public URL of the app, e.g.
# https://cs-trainer.example.com (required in production).
# APP_ORIGIN=http://localhost:5173
# Optional: prefill name/avatar from Steam (https://steamcommunity.com/dev/apikey).
# STEAM_WEB_API_KEY=
# Optional: FACEIT stats (https://developers.faceit.com, server-side key).
# FACEIT_API_KEY=

# Optional: match share code import. Valve only gives replay URLs to a logged-in
# game client, so this points at a replay provider (Game Coordinator bridge);
# see services/replayProvider.js for the contract.
# MATCH_REPLAY_PROVIDER_URL=
# MATCH_REPLAY_PROVIDER_TOKEN=
# Hosts replays may be downloaded from (comma-separated, * wildcard).
# MATCH_REPLAY_HOSTS=replay*.valve.net
