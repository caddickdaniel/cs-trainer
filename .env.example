# Copy to `.env` and adjust. `.env` is git-ignored.
# Local PostgreSQL connection strings (these are also the built-in defaults).
# With a password:      postgres://user:password@localhost:5432/cs_trainer
# Linux peer auth over the local socket (no password):
#                       postgres:///cs_trainer?host=/var/run/postgresql
DATABASE_URL=postgres://localhost:5432/cs_trainer
# Used only when NODE_ENV=test. Test setup refuses to run unless the database
# name ends in "_test".
TEST_DATABASE_URL=postgres://localhost:5432/cs_trainer_test

# At least 32 random characters. Required in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

PORT=9090
# Set to the number of reverse proxies in front of the app in production (e.g. 1).
TRUST_PROXY=0
# Defaults to true when NODE_ENV=production. Only set to false for local HTTP testing.
# COOKIE_SECURE=false
