{
  "name": "cs-trainer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CS-Trainer: plan Counter-Strike 2 rounds, assign player responsibilities and follow them live in Game Mode.",
  "main": "app.js",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "db:create": "node scripts/db-create.js",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "db:reset": "node scripts/db-reset.js",
    "db:review": "node scripts/db-review.js",
    "db:demo": "node scripts/seed-demo.js",
    "migrate:make": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed:db": "npm run db:reset",
    "setup": "npm run db:create && npm run db:reset",
    "dev": "node scripts/dev.js",
    "dev:server": "nodemon --watch . --ignore client --ignore spec --ignore storage listen.js",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node listen.js",
    "test": "NODE_ENV=test node scripts/db-create.js --test && NODE_ENV=test mocha",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace client",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "Daniel Caddick",
  "license": "ISC",
  "dependencies": {
    "@laihoe/demoparser2": "0.42.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "knex": "^2.5.1",
    "pg": "^8.12.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "chai": "^4.5.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "mocha": "^10.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.4",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "@laihoe/demoparser2": {
      "@laihoe/demoparser2-darwin-universal": "npm:@laihoe/demoparser2-android-arm-eabi@0.42.0",
      "@laihoe/demoparser2-darwin-x64": "npm:@laihoe/demoparser2-android-arm-eabi@0.42.0",
      "@laihoe/demoparser2-freebsd-x64": "npm:@laihoe/demoparser2-android-arm-eabi@0.42.0",
      "@laihoe/demoparser2-win32-ia32-msvc": "npm:@laihoe/demoparser2-android-arm-eabi@0.42.0"
    }
  }
}
